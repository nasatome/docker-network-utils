COMPOSE_PROJECT_NAME=inference

TZ=UTC

# ---------------------------------------------------------------------------
# Catálogo de modelos
# ---------------------------------------------------------------------------
# Ruta absoluta en el host al YAML con TUS modelos. Este repositorio es público
# y genérico: la infraestructura vive aquí, el catálogo vive fuera.
#
# Si dejas esto sin definir, el compose monta config/llama-swap.yaml.example,
# una plantilla con unos pocos modelos de ejemplo. Sirve para arrancar y ver
# los patrones, no como catálogo real.
#
# Ejemplo:
#   LLAMA_SWAP_CONFIG=/home/tu-usuario/.config/llama-swap/catalog.yaml
#LLAMA_SWAP_CONFIG=

# ---------------------------------------------------------------------------
# Ubicación de los pesos GGUF
# ---------------------------------------------------------------------------
# Ruta absoluta al directorio raíz de modelos en el host (bind read-only).
# Se monta en /models dentro del container: las rutas de tu catálogo se
# escriben relativas a ese punto. OBLIGATORIA, sin default.
MODELS_ROOT=/ruta/a/tus/modelos-gguf

# Opcional. Segundo directorio de modelos, pensado para un disco más rápido
# (p. ej. NVMe frente a mecánico). Se monta en /models-fast. Solo cambia el
# tiempo de cold start; la velocidad de generación es la misma.
# Si no se define, el compose monta ./config como placeholder inocuo.
#MODELS_ROOT_FAST=

# Opcional. Modelos que viven fuera del árbol de MODELS_ROOT, por ejemplo
# dentro del directorio de otro proyecto. Se monta en /extra-models.
# Si no se define, el compose monta ./config como placeholder inocuo.
#EXTRA_MODELS_ROOT=

# ---------------------------------------------------------------------------
# Red y puertos
# ---------------------------------------------------------------------------
# Puerto host expuesto en 127.0.0.1 para clientes no dockerizados.
HOST_PORT=8222

# Red docker externa compartida. Crear con scripts/init-network.sh antes del
# primer up.
LLM_NETWORK_NAME=ai_inference

# GPU(s) NVIDIA visibles para el container.
# Por defecto el compose usa `count: all` (todas las GPUs disponibles).
# Para restringir a una GPU específica, edita docker-compose.yml y reemplaza
# `count: all` por `device_ids: ["0"]` (lista hardcoded — compose no expande
# arrays via env). Para repartir modelos entre varias tarjetas, usa
# CUDA_VISIBLE_DEVICES por modelo en tu catálogo.
