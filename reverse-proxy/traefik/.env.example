COMPOSE_PROJECT_NAME=reverse
# STAGE : stable / devel
STAGE=stable
# Change the Email
ACME_EMAIL=CHANGE_ME@DOMAIN.com
# TRAEFIK_FRONTEND_RULE point to 127.0.0.1 in DNS
TRAEFIK_FRONTEND_RULE=local.traefik.CHANGE_DOMAIN.com
TRAEFIK_CERT_RESOLVER=myresolver
TRAEFIK_HOST_HTTP_PORT=80
TRAEFIK_HOST_HTTPS_PORT=443
# LOG LEVELS: INFO / DEBUG
TRAEFIK_LOG_LEVEL=DEBUG

# Access log. Off by default because it is high volume: budget roughly 200 bytes
# per request in common format and 500 in json, then multiply by your own
# traffic. Measure before enabling; do not guess.
TRAEFIK_ACCESS_LOG=false
# common | json. Prefer json unless something downstream demands CLF: several
# fields exist only in json, including OriginStatus, the status the BACKEND
# returned, which is what tells a broken app apart from a middleware rejection.
# Note that Traefik's "common" is not standard CLF either — it appends its own
# fields — so parser compatibility is a weaker argument than it looks.
TRAEFIK_ACCESS_LOG_FORMAT=json
# Host directory holding the access log. Point this at a path your log rotator
# owns, OUTSIDE this repository: access logs contain client IPs and full URLs,
# and a path inside the checkout risks being wiped by a clean or swept into a
# repo backup. The default keeps a fresh clone working out of the box.
TRAEFIK_LOG_DIR=./logs
TRAEFIK_DNS_PROVIDER=cloudflare
TRAEFIK_DNS_DELAY_BEFORE_CHECK=60s
TRAEFIK_API=true
TRAEFIK_API_DASHBOARD=true
TRAEFIK_PING=true
TRAEFIK_DEFAULT_DOCKER_NETWORK=reverse_traefik
#test:test
TRAEFIK_BASIC_AUTH_USERS=test:$2y$05$AkIat2ToKz1PQLbXkW/cBOgDAjJaZi0ECAacqBgp.Udhwv3r/BQFO #test:test

DOCKER_SOCK_PATH=/var/run/docker.sock
#rootless mode (change the user id to your own):
#DOCKER_SOCK_PATH=/run/user/1000/docker.sock
